{
  "aws___list_regions": {
    "unwrap": ["content", "result"],
    "return_model": "RegionSummary",
    "return_container": "list",
    "input_overrides": {},
    "fields": {
      "region_id": "str",
      "region_long_name": "str"
    },
    "source": "live",
    "probed_args": {}
  },
  "aws___search_documentation": {
    "unwrap": ["content", "result"],
    "return_model": "SearchDocumentationItem",
    "return_container": "list",
    "input_overrides": {},
    "fields": {
      "rank_order": "int",
      "title": "str",
      "context": "str",
      "url": "str",
      "skill_description": "str",
      "skill_name": "str"
    },
    "source": "live",
    "probed_args": [
      {
        "search_phrase": "AWS Lambda function timeout limit",
        "limit": 4
      },
      {
        "search_phrase": "AWS Lambda skill",
        "topics": ["agent_skills"],
        "limit": 4
      }
    ]
  },
  "aws___read_documentation": {
    "unwrap": ["content", "result"],
    "return_model": "DocumentationPage",
    "return_container": "list",
    "input_overrides": {},
    "fields": {
      "status": "str",
      "url": "str",
      "content": "str",
      "total_length": "int",
      "start_index": "int",
      "end_index": "int",
      "truncated": "bool",
      "redirected_url": "str | None",
      "error_code": "str | None"
    },
    "source": "live",
    "probed_args": {
      "requests": [
        {
          "url": "https://docs.aws.amazon.com/lambda/latest/dg/welcome.html",
          "max_length": 3000
        }
      ]
    }
  },
  "aws___retrieve_skill": {
    "unwrap": ["content"],
    "return_model": "SkillDocument",
    "input_overrides": {},
    "fields": {
      "skill_content": "str"
    },
    "source": "live",
    "probed_args": {
      "skill_name": "connecting-lambda-to-api-gateway"
    }
  },
  "aws___get_regional_availability": {
    "unwrap": ["content", "result"],
    "discriminator": "resource_type",
    "variants": {
      "product": {
        "return_model": "ProductAvailability",
        "fields": {
          "products": "dict",
          "next_token": "str | None",
          "failed_regions": "Any | None"
        }
      },
      "api": {
        "return_model": "ServiceApiAvailability",
        "fields": {
          "service_apis": "dict",
          "next_token": "str | None",
          "failed_regions": "Any | None"
        }
      },
      "cfn": {
        "return_model": "CfnResourceAvailability",
        "fields": {
          "cfn_resources": "dict",
          "next_token": "str | None",
          "failed_regions": "Any | None"
        }
      }
    },
    "input_overrides": {},
    "fields": {},
    "source": "live",
    "probed_args": {
      "regions": ["us-east-1"],
      "resource_type": "cfn",
      "filters": ["AWS::S3::Bucket"]
    }
  }
}
