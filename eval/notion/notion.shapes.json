{
  "notion-search": {
    "unwrap": ["results"],
    "return_container": "list",
    "discriminator": "query_type",
    "variants": {
      "internal": {
        "return_model": "SearchContentItem",
        "fields": {
          "id": "str",
          "title": "str",
          "url": "str",
          "type": "str",
          "highlight": "str",
          "timestamp": "str"
        },
        "source": "live"
      },
      "user": {
        "return_model": "SearchUserItem",
        "fields": {
          "text": "str"
        },
        "source": "live"
      }
    },
    "input_overrides": {"query_type": "str"},
    "source": "live",
    "probed_args": [
      {"query": "project plan", "query_type": "internal", "page_size": 5},
      {"query": "a", "query_type": "user", "page_size": 5},
      {"query": "tasks", "page_url": "https://app.notion.com/p/<PAGE_ID>", "page_size": 5}
    ],
    "probe_args_scrubbed": true
  },
  "notion-fetch": {
    "unwrap": [],
    "return_model": "NotionEntity",
    "return_container": null,
    "input_overrides": {},
    "fields": {
      "title": "str",
      "url": "str",
      "text": "str"
    },
    "source": "live",
    "probed_args": [
      {"id": "<PAGE_ID>", "include_discussions": true},
      {"id": "self"}
    ],
    "probe_args_scrubbed": true
  },
  "notion-get-users": {
    "unwrap": ["results"],
    "return_container": "list",
    "return_model": "WorkspaceUserSummary",
    "input_overrides": {},
    "fields": {
      "type": "str",
      "id": "str",
      "name": "str"
    },
    "source": "live",
    "probed_args": {"page_size": 5}
  },
  "notion-get-teams": {
    "unwrap": [],
    "return_model": "TeamsResult",
    "return_container": null,
    "input_overrides": {},
    "fields": {
      "joinedTeams": "list",
      "otherTeams": "list",
      "hasMore": "bool"
    },
    "source": "live",
    "probed_args": {}
  },
  "notion-list-private-pages": {
    "unwrap": ["results"],
    "return_container": "list",
    "return_model": "SidebarPageSummary",
    "input_overrides": {},
    "fields": {
      "type": "str",
      "url": "str",
      "title": "str"
    },
    "source": "live",
    "probed_args": {"limit": 5}
  },
  "notion-list-favorite-pages": {
    "unwrap": ["results"],
    "return_container": "list",
    "return_model": "SidebarPageSummary",
    "input_overrides": {},
    "fields": {
      "type": "str",
      "url": "str",
      "title": "str"
    },
    "source": "live",
    "probed_args": {"limit": 5}
  },
  "notion-list-recent-pages": {
    "unwrap": ["results"],
    "return_container": "list",
    "return_model": "RecentPageSummary",
    "input_overrides": {},
    "fields": {
      "type": "str",
      "url": "str",
      "title": "str",
      "icon": "str"
    },
    "source": "live",
    "probed_args": {"limit": 5}
  },
  "notion-list-shared-pages": {
    "unwrap": ["results"],
    "return_container": "list",
    "return_model": null,
    "input_overrides": {},
    "fields": {},
    "source": "live",
    "probed_args": {"limit": 5}
  },
  "notion-query-data-sources": {
    "unwrap": [],
    "return_model": "DataSourceQueryResult",
    "return_container": null,
    "input_overrides": {},
    "fields": {
      "results": "list",
      "has_more": "bool",
      "data_source_ids": "list"
    },
    "source": "live",
    "probed_args": {
      "data": {
        "mode": "sql",
        "data_source_urls": ["collection://<DATA_SOURCE_ID>"],
        "query": "SELECT * FROM \"collection://<DATA_SOURCE_ID>\" LIMIT 3"
      }
    },
    "probe_args_scrubbed": true
  },
  "notion-get-comments": {
    "unwrap": [],
    "return_model": null,
    "return_container": null,
    "input_overrides": {},
    "fields": {},
    "source": "live",
    "probed_args": {"page_id": "<PAGE_ID>", "include_resolved": true, "include_all_blocks": true},
    "probe_args_scrubbed": true
  },
  "notion-query-meeting-notes": {
    "unwrap": [],
    "return_model": null,
    "return_container": null,
    "input_overrides": {},
    "fields": {},
    "source": "live",
    "probed_args": {},
    "_probe_status": "inconclusive"
  },
  "notion-search-agents": {
    "unwrap": [],
    "return_model": null,
    "return_container": null,
    "input_overrides": {},
    "fields": {},
    "source": "live",
    "probed_args": {"scope": "workspace", "limit": 5},
    "_probe_status": "inconclusive"
  }
}
